# Copy this file to .env and fill in real values.
# NEVER commit a real .env file — it's already in .gitignore.

# --- App ---
APP_ENV=local
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Database (used starting Phase 2) ---
DATABASE_URL=postgresql+asyncpg://omnirag:omnirag@localhost:5432/omnirag

# --- Vector DB (used starting Phase 6) ---
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=document_chunks
DEFAULT_SEARCH_TOP_K=5

# --- Redis / background jobs (used starting Phase 4) ---
REDIS_URL=redis://localhost:6379/0

# --- File storage / ingestion (Phase 4) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
# ALLOWED_UPLOAD_EXTENSIONS is a code-level default (.pdf, .docx, .txt, .md)
# rather than an env var — extending it means adding a new extractor in
# app/ingestion/extractors.py anyway, so there's no meaningful "supported
# extension with no parser" state to configure around.

# --- Auth (used starting Phase 3) ---
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM / embedding providers (used starting Phase 5/7) ---
# Only fill in the ones you plan to use — providers are pluggable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- RAG generation (Phase 7) ---
# 'local' needs no API key/network and is what lets the full RAG pipeline
# (search -> generate -> cite) run end-to-end out of the box — it does real
# extractive answering (ranks and returns the most relevant retrieved
# sentences verbatim), not true generation. See
# app/llm/local_extractive.py for the honest tradeoffs. Switch to
# 'anthropic' or 'openai' (with the matching API key above) for real
# generated answers.
LLM_PROVIDER=local
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=8000

# --- Hybrid retrieval + re-ranking (Phase 8) ---
# Both default on. Turning either off is mainly useful for A/B comparison
# once Phase 15 (RAG evaluation) exists — see app/services/search_service.py.
ENABLE_KEYWORD_SEARCH=true
ENABLE_RERANKING=true
HYBRID_CANDIDATE_MULTIPLIER=4
RRF_K=60

# --- Chunking (Phase 5) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings (Phase 5) ---
# 'local' needs no API key/network and is what this repo can run fully
# end-to-end out of the box. Switch to 'openai' (and set OPENAI_API_KEY
# above) for real semantic embeddings — see app/embeddings/local_hashing.py
# for the honest tradeoffs of the default.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# NOTE: if you switch EMBEDDING_PROVIDER to openai, also set
# EMBEDDING_DIMENSION=1536 to match text-embedding-3-small's real output
# size — existing local-provider chunks would need re-embedding, since
# vectors from different models/dimensions are not comparable.

# --- Observability (used starting Phase 16) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- RAG evaluation (Phase 15) ---
# 'local' (LocalHeuristicEvaluator) needs no API key/network. 'ragas' is a
# real integration against the Ragas library's LLM-judged metrics but
# needs OPENAI_API_KEY set above, and the ragas package installed
# separately (see backend/requirements.txt's Phase 15 comment).
EVAL_PROVIDER=local
EVAL_JUDGE_MODEL=gpt-4o-mini

# --- FREE LLM (recommended: fixes "answers only copy sentences from the docs") ---
# LLM_PROVIDER=local only extracts sentences. For real written answers, use any
# OpenAI-compatible endpoint. Pick ONE block, uncomment it, and put your key in
# OPENAI_API_KEY. Then verify with:   python -m app.llm.check
# (Model names change — if you get a 404, check the provider's model list.)
#
# Groq (free tier; key starts with gsk_):  https://console.groq.com/keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (free tier):  https://aistudio.google.com/apikey
# LLM_PROVIDER=openai
# OPENAI_API_KEY=<gemini key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-2.5-flash
#
# OpenRouter (has ":free" models):  https://openrouter.ai/keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Ollama (fully local, no key; run `ollama pull llama3.2` first):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_CHAT_MODEL=llama3.2
