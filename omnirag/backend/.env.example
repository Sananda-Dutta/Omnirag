# Copy this file to .env and fill in real values.
# NEVER commit a real .env file — it's already in .gitignore.

# --- App ---
APP_ENV=local
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Database (used starting Phase 2) ---
DATABASE_URL=postgresql+asyncpg://omnirag:omnirag@localhost:5432/omnirag

# --- Vector DB (used starting Phase 6) ---
VECTOR_DB_URL=http://localhost:6333

# --- Redis / background jobs (used starting Phase 4) ---
REDIS_URL=redis://localhost:6379/0

# --- File storage / ingestion (Phase 4) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
# ALLOWED_UPLOAD_EXTENSIONS is a code-level default (.pdf, .docx, .txt, .md)
# rather than an env var — extending it means adding a new extractor in
# app/ingestion/extractors.py anyway, so there's no meaningful "supported
# extension with no parser" state to configure around.

# --- Auth (used starting Phase 3) ---
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM / embedding providers (used starting Phase 5/7) ---
# Only fill in the ones you plan to use — providers are pluggable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Chunking (Phase 5) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings (Phase 5) ---
# 'local' needs no API key/network and is what this repo can run fully
# end-to-end out of the box. Switch to 'openai' (and set OPENAI_API_KEY
# above) for real semantic embeddings — see app/embeddings/local_hashing.py
# for the honest tradeoffs of the default.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# NOTE: if you switch EMBEDDING_PROVIDER to openai, also set
# EMBEDDING_DIMENSION=1536 to match text-embedding-3-small's real output
# size — existing local-provider chunks would need re-embedding, since
# vectors from different models/dimensions are not comparable.

# --- Observability (used starting Phase 16) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
