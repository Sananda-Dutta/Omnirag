# Add/replace these lines in backend/.env ON THE SERVER (keep your LLM keys etc.).
# Never commit the real file.

# --- Neon Postgres ---
# Use the DIRECT connection string (host WITHOUT "-pooler"), converted for asyncpg:
#   driver  -> postgresql+asyncpg://
#   query   -> ?ssl=require        (asyncpg does not understand sslmode= or channel_binding=)
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_2uoATJdwIYj1@ep-sweet-fire-a1wi0rtf.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# --- Qdrant Cloud ---
# Cluster URL from the Qdrant Cloud console (keep the :6333)
VECTOR_DB_URL=https://xxxx.region.provider.cloud.qdrant.io:6333
# Name this to whatever your settings class reads (see note in the chat reply)
QDRANT_API_KEY=your-qdrant-api-key
